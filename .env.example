# Defaults require no key: deterministic baseline, in-memory vector search.
TRIAGE_PROVIDER=baseline
RETRIEVAL_BACKEND=memory
RETRIEVAL_MODE=hybrid_rerank
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
MCP_URL=http://localhost:8001/mcp
# Optional OpenAI-compatible chat completion server, e.g. local Ollama.
# For Docker Desktop, use http://host.docker.internal:11434/v1 for a model
# running on the host; localhost inside the API container points at the container.
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=
MODEL_API_KEY=
# Set BOTH prices to record estimated token charges (currency USD per million tokens).
# MODEL_INPUT_COST_PER_MILLION=
# MODEL_OUTPUT_COST_PER_MILLION=
TRIAGE_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=5
MAX_TOOL_CALLS=12
